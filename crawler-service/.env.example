# Must match CRAWLER_API_TOKEN in the Laravel .env
CRAWLER_API_TOKEN=replace-with-local-secret
# Only for crawling a local fixture site during development. Never enable in production.
CRAWLER_ALLOW_PRIVATE_HOSTS=false
CRAWLER_MAX_CONCURRENT_CRAWLS=3
# Where crawl results are persisted (kept for 1 hour after a crawl finishes)
# CRAWLER_DATA_DIR=/var/www/html/my/GROWVIA-SEO/crawler-service/data
