[Unit]
Description=Growvia SEO crawler service (127.0.0.1:8100)
After=network-online.target

[Service]
WorkingDirectory=__PROJECT__/crawler-service
ExecStart=__PROJECT__/crawler-service/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
